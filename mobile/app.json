{
  "expo": {
    "name": "MemoSync",
    "slug": "memosync-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#fbfbfa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memosync.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "MemoSync connects to a MemoSync host on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.memosync.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MemoSync uses the camera to scan the pairing QR code shown on your computer."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow MemoSync to unlock your paired device credentials."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
