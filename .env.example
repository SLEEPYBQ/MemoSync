# MemoSync configuration — copy this file to .env and fill in the key.
#
# Isolate testing from your normal Claude Code and Codex subscriptions.
# MemoSync creates separate claude/ and codex/ directories under this profile.
# No global settings or auth files are edited, and host logins are not used.
# Omit both settings to use your existing official CLI subscriptions instead.
MEMOSYNC_ISOLATE_CLI=1
# MEMOSYNC_CLI_PROFILE_DIR=/absolute/path/to/memosync-test-profile

# GLM supports both Claude Code and Codex. Supply the key only in your local
# environment/.env; never commit it. Main sessions and memory branches use
# the same provider. Select GLM in the Claude Code model picker.
GLM_API_KEY=
# GLM_MODEL=glm-5.3-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# GLM_CODEX_BASE_URL=https://open.bigmodel.cn/api/v1
# MEMOSYNC_CODEX_PROVIDER=glm
# MEMOSYNC_CODEX_MODEL=glm-5.3-flash

# Optional DeepSeek provider (Claude Code Anthropic-compatible endpoint).
# DEEPSEEK_API_KEY=

# Optional overrides (defaults shown).
# DEEPSEEK_MODEL=deepseek-v4-flash        # deepseek-v4-flash | deepseek-v4-flash-vision-exp | deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PORT=3210

# Optional custom Codex provider in an isolated profile. Requires a Responses
# API endpoint. Chat Completions endpoints are not interchangeable with it.
# MEMOSYNC_CODEX_PROVIDER=custom
# MEMOSYNC_CODEX_API_KEY=
# MEMOSYNC_CODEX_BASE_URL=https://api.openai.com/v1
# MEMOSYNC_CODEX_MODEL=your-model-id

# Optional: context management for the Claude Code engine. MemoSync selects the
# 1M-token context window on every DeepSeek session and auto-compacts the
# conversation once it grows past this many tokens.
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432

# Advanced: with DEEPSEEK_API_KEY set, MemoSync derives and OVERRIDES the
# ANTHROPIC_* engine variables — leftover exports from other Claude Code
# setups in your shell are ignored on purpose. To run the chat engine on your
# own ANTHROPIC_* configuration (e.g. a real Anthropic key or another
# Anthropic-compatible endpoint) instead, opt out explicitly:
# MEMOSYNC_USE_OWN_ANTHROPIC=1
