# MemoSync needs no .env. Connect models in Settings → Models.
#
# Everything below is optional. Keys set here appear in Settings as read-only
# connections, so older setups keep working; new setups should add a
# connection in the app instead.

# PORT=3210
# MEMOSYNC_USAGE_LOG=0          # stop the local usage log

# Keep every engine off your own CLI logins: account access is disabled and
# each engine must use an API connection, run in its own profile.
# MEMOSYNC_ISOLATE_CLI=1
# MEMOSYNC_CLI_PROFILE_DIR=/absolute/path/to/profiles

# Environment-defined connections (shown read-only in Settings).
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GLM_API_KEY=
# GLM_MODEL=glm-5.3-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# GLM_CODEX_BASE_URL=https://open.bigmodel.cn/api/v1
# OPENROUTER_API_KEY=
# MEMOSYNC_CODEX_API_KEY=
# MEMOSYNC_CODEX_BASE_URL=https://api.openai.com/v1
# MEMOSYNC_CODEX_MODEL=your-model-id

# With DEEPSEEK_API_KEY set, leftover ANTHROPIC_* exports in your shell are
# ignored. Set this to run Claude Code on your own ANTHROPIC_* variables.
# MEMOSYNC_USE_OWN_ANTHROPIC=1
